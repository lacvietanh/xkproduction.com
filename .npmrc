# Force npm to include all optional deps for all platforms in lock file
# Needed for @takumi-rs/core (via nuxt-og-image) cross-platform lock file compatibility
include=optional

# Do not enforce peer dependency auto-install (npm 6 behavior)
# Prevents "Missing from lock file" errors on Cloudflare Pages (npm 10.x) for
# optional packages like @napi-rs/wasm-runtime whose peer deps differ per platform
legacy-peer-deps=true
